# Copy to .env on the server (chmod 600). Never commit .env.
# lowercase GitHub owner of the images: ghcr.io/<owner>/sevadesk-api
GITHUB_OWNER=techexpressapp
TAG=latest

# Domains: tenants live at <slug>.sevadesk.app; custom domains (iskconsomerset.org) are looked up in the tenant table.
BASE_DOMAINS=sevadesk.app
TZ=America/New_York

# First admin login for the temple (created on first start only). Delete the password line after you sign in.
BOOTSTRAP_TENANT_SLUG=iskconsomerset
BOOTSTRAP_ADMIN_EMAIL=you@iskconsomerset.org
BOOTSTRAP_ADMIN_PASSWORD=at-least-12-characters
ACME_EMAIL=you@example.com

# Database
POSTGRES_DB=sevadesk
POSTGRES_USER=sevadesk
POSTGRES_PASSWORD=change-me-long-random
APP_DB_USER=sevadesk_app
APP_DB_PASSWORD=change-me-long-random

# Email for "forgot password" and new-user links (optional). Any SMTP service: Google Workspace
# (smtp.gmail.com + an app password), Brevo (smtp-relay.brevo.com), Amazon SES. Leave SMTP_HOST empty to
# turn email off; admins then give out temporary passwords from the Users screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=SevaDesk <no-reply@iskconsomerset.org>

# Stripe (the temple's own account). Start with test keys (sk_test_...), switch to live keys when ready.
# Webhook endpoint to add in Stripe: https://www.iskconsomerset.org/api/public/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=change-me

# Backups -> Cloudflare R2 (S3 API). Create an R2 API token limited to the backup bucket.
BACKUP_BUCKET=sevadesk-backups
# Public key from:  age-keygen -o backup.agekey   (keep backup.agekey OFFLINE; only the public key goes here)
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_HEALTHCHECK_URL=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional tuning for a small VM
# API_MEM_LIMIT=512m     # container memory for the API (heap is 65% of it)
# DB_POOL_SIZE=5         # database connections held by the API

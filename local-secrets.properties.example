# Copy to local-secrets.properties (same folder; it is git-ignored) and fill in YOUR Stripe TEST keys.
# Used only when running the API locally with the dev profile.
#
# 1. https://dashboard.stripe.com/test/apikeys  ->  "Secret key" (starts with sk_test_)
sevadesk.stripe.accounts.iskconsomerset.secret-key=
#
# 2. Webhook signing secret (starts with whsec_). Locally, get it from the Stripe CLI:
#      stripe login
#      stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,invoice.paid --forward-to localhost:8080/api/public/stripe/webhook
#    It prints "Your webhook signing secret is whsec_..." - paste that here and keep `stripe listen` running.
sevadesk.stripe.accounts.iskconsomerset.webhook-secret=
